{
  "name": "watchparty-backend",
  "version": "1.0.0",
  "private": true,
  "description": "WatchParty Backend - Express + Socket.IO + Prisma",
  "workspaces": [
    "apps/server",
    "packages/types"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=apps/server",
    "build": "npm run build --workspace=packages/types && npm run build --workspace=apps/server",
    "start": "npm run start --workspace=apps/server",
    "test": "npm run test --workspace=apps/server",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "db:generate": "npm run db:generate --workspace=apps/server",
    "db:migrate": "npm run db:migrate --workspace=apps/server",
    "db:migrate:deploy": "npm run db:migrate:deploy --workspace=apps/server"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.0.0"
  }
}